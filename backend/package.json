{
  "name": "dynamicrestobar-backend",
  "version": "1.0.0-alpha",
  "description": "API REST para DynamicRestoBar - Sistema POS Restaurante & Bar",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "bridge:agent": "node scripts/printBridgeAgent.js",
    "reset:data": "node scripts/reset-production-data.js --profile=operacion",
    "reset:data:execute": "node scripts/reset-production-data.js --profile=operacion --execute --confirm=RESET_PRODUCCION",
    "reset:sede": "node scripts/reset-sede-data.js",
    "reset:sede:execute": "node scripts/reset-sede-data.js --execute --confirm=RESET_SEDE",
    "purge:clientes": "node scripts/purge-old-clients-keep-catalogs.js",
    "purge:clientes:execute": "node scripts/purge-old-clients-keep-catalogs.js --execute --confirm=PURGE_CLIENTES_KEEP_CATALOGOS",
    "purge:clientes:core": "node scripts/purge-old-clients-keep-catalogs.js --wipe-core",
    "purge:clientes:core:execute": "node scripts/purge-old-clients-keep-catalogs.js --wipe-core --execute --confirm=PURGE_CLIENTES_Y_CORE",
    "migrate": "knex migrate:latest --knexfile src/config/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/config/knexfile.js",
    "migrate:list": "knex migrate:list --knexfile src/config/knexfile.js",
    "seed": "knex seed:run --knexfile src/config/knexfile.js",
    "seed:metodos-pago": "node seed-metodos-pago.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "build": "node -e \"console.log('No build step for backend')\""
  },
  "keywords": [
    "pos",
    "restaurante",
    "bar",
    "inventario",
    "comandas"
  ],
  "author": "DynamicRestoBar Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
